# Free local defaults
MAX_VIDEO_DURATION=1800
MAX_FILE_SIZE_MB=1000
# Free daily/project clip cap; /api/plans reports the configured value.
MAX_CLIPS=10
FREE_PLAN_CLIPS=10
FREE_PLAN_VIDEOS=2
WHISPER_MODEL=tiny.en
PROCESSING_WORKERS=2
FREE_MODE=true
LOCAL_AI=true
ALLOW_CLOUD_AI=false
LOCAL_MODEL=tiny.en
PRIVACY_MODE=true
ALLOW_OFFICIAL_APIS=false
MAX_STORAGE_GB=20
RETENTION_DAYS=0

# Non-intrusive free-tier advertising. Ads never appear in editor, processing, download, or publishing flows.
ADS_ENABLED=true
MAX_ADS_PER_SESSION=5
MIN_AD_INTERVAL_SECONDS=120
USER_PLAN=free
# Optional: point storage at another local disk
# STORAGE_ROOT=/absolute/path/to/storage
# DATABASE_PATH=/absolute/path/to/storage/viral_clips.sqlite3

# Authentication and email delivery. Console mode is safe for local testing; SMTP is optional.
AUTH_REQUIRED=true
# Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://127.0.0.1:5173
ENVIRONMENT=development
EMAIL_DELIVERY=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_EMAILS=admin@example.com

# Payment provider. Leave as none until Razorpay test/live keys and webhooks are configured.
PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_...
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PADDLE_API_KEY=
# LEMONSQUEEZY_API_KEY=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID_PRO=plan_...
# RAZORPAY_USE_SUBSCRIPTIONS=false
PRO_PRICE_MONTHLY=99


# Optional official social developer apps. Leave blank in Free Mode until configured.
# OAuth redirect should be registered in each official developer console.
# SOCIAL_OAUTH_REDIRECT_URI=http://localhost:5173/api/social/oauth/callback
# TOKEN_ENCRYPTION_KEY=<generate a Fernet key; tokens are encrypted at rest>
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
